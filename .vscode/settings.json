{
  // --- Editor ---
  "editor.largeFileOptimizations": true,
  "editor.tabSize": 4,
  "editor.formatOnSave": true,

  // --- Files ---
  // When enabled, will trim trailing whitespace when you save a file.
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.pode": "html"
  },

  // --- Markdown --

  // --- Markdown/Linting ---
  "markdownlint.config": {
    "default": true,
    "MD003": {
      "style": "atx"
    },
    "MD013": false,
    "MD024": false,
    "MD029": {
      "style": "one_or_ordered"
    },
    "MD033": false,
    "MD034": false,
    "no-hard-tabs": true
  },

  // --- VSCode ---
  // --- VSCode/Language ---
  "vscode.json-language-features": true,

  // ---> PowerShell --->
  "[powershell]": {
    "debug.saveBeforeStart": "nonUntitledEditorsInActiveGroup",
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "editor.semanticHighlighting.enabled": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "editor.defaultFormatter": "ms-vscode.powershell"
  },

  // --- PowerShell/ScriptAnalysis ---
  // specifies the location of the explicitly ScriptAnalyzer settings file
  "powershell.scriptAnalysis.enable": true,
  "powershell.scriptAnalysis.settingsPath": "/config/PSScriptAnalyzerSettings.psd1",
  //"powershell.scriptAnalysis.settingsPath": "${workspaceFolder}/src/PSScriptAnalyzerSettings.psd1",

  // --- PowerShell/Code Formatting ---
  // specifies the PowerShell coding style used in this project (https://github.com/PoshCode/PowerShellPracticeAndStyle/issues/81)
  "powershell.codeFormatting.ignoreOneLineBlock": false,
  "powershell.codeFormatting.preset": "Custom",
  "powershell.codeFormatting.openBraceOnSameLine": true,
  "powershell.codeFormatting.newLineAfterOpenBrace": true,
  "powershell.codeFormatting.newLineAfterCloseBrace": true,
  "powershell.codeFormatting.whitespaceAroundOperator": true,
  "powershell.codeFormatting.whitespaceBeforeOpenParen": true,
  "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
  //"powershell.codeFormatting.useCorrectCasing": true,
  "powershell.codeFormatting.autoCorrectAliases": true,

  // <--- PowerShell <---

  // --- Editor/Default Formatter ---
  // "[markdown]": {
  //   "editor.defaultFormatter": "darkriszty.markdown-table-prettify"
  // },
  // "[sql]": {
  //   "editor.defaultFormatter": "adpyke.vscode-sql-formatter"
  // },
  // "[xml]": {
  //   "editor.defaultFormatter": "PrateekMahendrakar.prettyxml"
  // },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.suggest.insertMode": "replace",
    "editor.quickSuggestions": {
      "strings": true
    }
  },
  // "json.schemas": [
  //   {
  //     "fileMatch": ["**/*.adf.json"],
  //     "url": "./.vscode/Schema-Atlassian-Document-Format.json"
  //   }
  // ],
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

