  //   "ts": "warning",
  //   "eslint": "warning"
  // },

  // --- GitLens ---
  // "gitlens.launchpad.indicator.useColors": true,
  // "gitlens.telemetry.enabled": false,
  // "gitlens.advanced.commits.delayLoadingFileDetails": true,

  // --- GitLens/AI ---
